table fact_flujo_fondos
	lineageTag: 5f55ae2e-80d7-5ad1-aa78-5ab0463977d1

	column id_proyecto
		dataType: string
		isHidden
		lineageTag: f5dcd552-4002-546a-9eea-4f13d8434d75
		summarizeBy: none
		sourceColumn: id_proyecto

	column mes
		dataType: dateTime
		formatString: Long Date
		lineageTag: 2ba8db70-34a4-5c94-bad9-683fa38da4d0
		summarizeBy: none
		sourceColumn: mes

		annotation UnderlyingDateTimeDataType = Date

	column forecast_usd
		dataType: int64
		lineageTag: 329ef296-4e12-5cc1-9cc5-630cba9b0b0b
		summarizeBy: none
